    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bench</RootNamespace>
    <AssemblyName>Bench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
