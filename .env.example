# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------------------
# Topology
# ---------------------------------------------------------------------------
# single      = everything on one host (development / smoke only)
# distributed = one host per role (measurement)
BENCH_MODE=single

# Private-network addresses of the three nodes, REQUIRED only when
# BENCH_MODE=distributed. The orchestration scripts (`up.sh`, `run-trial.sh`,
# `exec-trial.sh`, `down.sh`) address them via `ssh://` (DOCKER_HOST), and
# docker-compose uses them for cross-host service discovery.
#
# IMPORTANT: leave these UNSET (commented out) when BENCH_MODE=single --
# the compose file falls back to the container DNS names (db/app) and a set
# value here would point the app and exporters at a non-existent node.
#BENCH_LOAD_HOST=10.10.0.10
#BENCH_APP_HOST=10.10.0.11
#BENCH_DB_HOST=10.10.0.12

# 9000 for a jumbo-frame fabric, 1500 otherwise. A mismatch with the physical
# switch silently costs throughput.
BENCH_MTU=9000

# ---------------------------------------------------------------------------
# Resource boundaries (see docs/benchmark/resources.md)
# ---------------------------------------------------------------------------
# Cores dedicated to the application under test. Must be a contiguous physical
# core set on one NUMA node, and identical for every framework.
APP_CPUSET=2-5
APP_CPUS=4
APP_MEMORY=4g

# The database is deliberately given more headroom than the app so it is never
# the bottleneck. Verify this with bench/scripts/check-db-headroom.sh.
DB_CPUSET=8-15
DB_CPUS=8
DB_MEMORY=16g

LOADGEN_CPUSET=2-9
LOADGEN_CPUS=8
LOADGEN_MEMORY=8g

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_VERSION=16
POSTGRES_DB=bench
POSTGRES_USER=bench
# Change this. It is only reachable on the private benchmark network, but a
# default credential in a repo is still a default credential.
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_PORT=5432

# Sizes the seed data set. See docs/benchmark/database.md for why these values
# matter to the read workload.
SEED_PRODUCTS=100000
SEED_CUSTOMERS=50000
SEED_ORDERS=250000

# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------
APP_PORT=8080
APP_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Grafana is bound to loopback only by default. Set a real password before
# exposing it on any network.
GRAFANA_ADMIN_PASSWORD=change-me-before-running
SCRAPE_INTERVAL=1s
