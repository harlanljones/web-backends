# Environment / secrets
.env
.env.*
!.env.example

# Local seed outputs
bench/seed/out/
/seed/

# Benchmark runs (raw trial artifacts)
/runs/
/results/
/report.json

# Analysis fixture output (regenerated by CI; never a published result)
bench/analysis/testdata/.output/

# Go
apps/go/go
apps/**/bin/
apps/**/vendor/
apps/**/*.test
apps/**/*.out
apps/**/coverage.out
apps/**/coverage.html
apps/**/.cache/

# Rust
# Cargo.lock is committed so the benchmark builds reproducibly.
apps/rust/target/

# Node
apps/node/node_modules/
apps/node/dist/
apps/node/coverage/

# Python
apps/python/__pycache__/
apps/python/**/__pycache__/
apps/python/.venv/
apps/python/venv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# Java / Spring
apps/spring/target/
apps/spring/.gradle/
apps/spring/build/
apps/spring/.idea/
apps/spring/.mvn/

# .NET / ASP.NET
apps/aspnet/bin/
apps/aspnet/obj/

# Elixir / Phoenix
apps/phoenix/_build/
apps/phoenix/deps/
apps/phoenix/cover/
apps/phoenix/.elixir_ls/
apps/phoenix/erl_crash.dump

# Bun
apps/bun/node_modules/
apps/bun/dist/

# Generic build / editor noise
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
*.class

# Docker / Compose local overrides
**/Dockerfile.local
